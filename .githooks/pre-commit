#!/bin/bash
set -euo pipefail

limit=20000

git diff --cached --numstat -z --no-renames --no-ext-diff --no-textconv \
  --ignore-submodules=all --diff-filter=AMT |
  (
    failed=0
    while IFS= read -r -d '' entry; do
      if [[ "$entry" == -$'\t'-$'\t'* ]]; then
        continue
      fi

      path=${entry#*$'\t'}
      path=${path#*$'\t'}
      case "/$path" in
        */package-lock.json|*/npm-shrinkwrap.json|*/pnpm-lock.yaml|*/yarn.lock|*/bun.lock|*/Cargo.lock|*/uv.lock|*/poetry.lock) continue ;;
        */node_modules/*|*/target/*|*/dist/*|*/dist-*/*|*/generated/*|*/vendor/*|*.min.js|*.min.css) continue ;;
        /apps/desktop/release/*|/apps/desktop/release-*/*|*/src/main/resources/static/admin/*) continue ;;
        /artifacts/*|/.experience-audit/*|/audit/source-before-*/*|/backups/*|/data/raw/*|*/public/live2d/*|*/public/live2d-core/*) continue ;;
        /packaging/cache/*|/packaging/staging/*|/packaging/release/staging/*|/packaging/release/model-packs/*) continue ;;
      esac

      size=$(git cat-file -s ":0:$path")
      if (( size > limit )); then
        tokens=$(( (size + 3) / 4 ))
        printf '提交文件「%s」有 %s 字节（约 %s token），超过 %s 字节。请按功能拆分后重新暂存并提交。\n' \
          "$path" "$size" "$tokens" "$limit" >&2
        failed=1
      fi
    done
    exit "$failed"
  )
