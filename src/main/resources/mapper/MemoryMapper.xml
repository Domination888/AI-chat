<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="org.example.aichat.mapper.MemoryMapper">

    <select id="findByConversationId" resultType="org.example.aichat.dto.Memory">
        SELECT * FROM memory
        WHERE conversation_id = #{conversationId}
    </select>

    <insert id="insert">
        INSERT INTO memory(conversation_id, summary, token_count)
        VALUES(#{conversationId}, #{summary}, #{tokenCount})
    </insert>

    <update id="update">
        UPDATE memory
        SET summary = #{summary},
        token_count = #{tokenCount},
        updated_at = NOW()
        WHERE conversation_id = #{conversationId}
    </update>

    <delete id="deleteByConversationId">
        DELETE FROM memory WHERE conversation_id = #{conversationId}
    </delete>

</mapper>