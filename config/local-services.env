# AI-Chat 本机服务连接（与 application-local.yml 保持一致）
# Agent / 脚本请优先通过 scripts/local-db.sh 访问，避免 PATH 问题

MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=meng050319
MYSQL_DATABASE=ai_chat
MYSQL_BIN=/usr/local/mysql-8.4.5-macos15-arm64/bin/mysql

REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_CLI=/opt/homebrew/bin/redis-cli

# JDBC / Redis URL（供文档或脚本引用）
MYSQL_JDBC_URL=jdbc:mysql://localhost:3306/ai_chat?useSSL=false&serverTimezone=Asia/Shanghai&useUnicode=true&characterEncoding=UTF-8&connectionCollation=utf8mb4_unicode_ci
REDIS_URL=redis://localhost:6379
